__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so

# ----------------------------------------------------------
# Virtual Environments
# ----------------------------------------------------------
venv/
.venv/
env/
ENV/
.python-version
LTTShackathon/
